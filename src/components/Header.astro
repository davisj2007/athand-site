---
import mark from "../assets/logo-lockup-mark.svg?raw";
import ThemeControl from "./ThemeControl.astro";

interface Props {
  current: string;
}

const { current } = Astro.props;
const nav = [
  { key: "/features", href: "/features.html", label: "Features" },
  { key: "/pricing", href: "/pricing.html", label: "Pricing" },
  { key: "/privacy-overview", href: "/privacy-overview.html", label: "Privacy" },
  { key: "/support", href: "/support.html", label: "Support" },
];
---
<header class="site">
  <div class="wrap">
    <a class="lockup" href="/" aria-label="atHand, home" aria-current={current === "/" ? "page" : undefined}><Fragment set:html={mark} /><span class="lockup-word" aria-hidden="true">Hand</span></a>
    <nav class="site-nav" aria-label="Main">
      <ul>
        {nav.map((item) => (
          <li><a href={item.href} aria-current={current === item.key ? "page" : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <ThemeControl />
  </div>
</header>
