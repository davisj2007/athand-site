---
import markSvg from "../assets/logo-lockup-mark.svg?raw";
import ThemeControl from "./ThemeControl.astro";

interface Props {
  current: string;
}

const { current } = Astro.props;
// The name on the link, "atHand, home", covers the lockup, so the inline mark
// is hidden from assistive tech instead of announcing its "at" label. "Hand"
// is drawn by CSS (.lockup-word::after) so the link has no visible text that
// differs from its name.
const mark = markSvg.replace('role="img" aria-label="at"', 'aria-hidden="true" focusable="false"');
const nav = [
  { key: "/features", href: "/features.html", label: "Features" },
  { key: "/pricing", href: "/pricing.html", label: "Pricing" },
  { key: "/privacy-overview", href: "/privacy-overview.html", label: "Privacy" },
  { key: "/support", href: "/support.html", label: "Support" },
];
---
<header class="site">
  <div class="container header-grid">
    <a class="lockup" href="/" aria-label="atHand, home" aria-current={current === "/" ? "page" : undefined}><Fragment set:html={mark} /><span class="lockup-word" aria-hidden="true"></span></a>
    <nav class="site-nav" aria-label="Main">
      <ul>
        {nav.map((item) => (
          <li><a href={item.href} aria-current={current === item.key ? "page" : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
    <ThemeControl />
  </div>
</header>
