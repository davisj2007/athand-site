---
// One App Store screenshot in a phone frame (HOME-DESIGN.md, Phone frame).
// Each shot has a light and a dark PNG in src/assets/shots/; both render as
// WebP and CSS shows the one that matches the theme, so the hidden one leaves
// the accessibility tree and, when lazy, is not downloaded. The crop is CSS
// (aspect-ratio and object-position by data-crop), so one file serves every view.
// A frame with `theme` shows that appearance whatever the site theme: it loads
// and renders only that file, with no shot-light or shot-dark class to swap.
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  shot: string;
  alt: string;
  crop: "full" | "suggest" | "record" | "perks" | "fields" | "lock";
  hero?: boolean;
  caption?: string;
  class?: string;
  theme?: "light" | "dark";
}

const { shot, alt, crop, hero = false, caption, class: className, theme } = Astro.props;

// Not eager, so a page imports only the shots it uses. Vite still emits every
// PNG the pattern matches, and Astro deletes an original only once it has been
// converted, so a shot no page shows would ship as a full PNG. 03-person-documents,
// the 05 pair, and 06-lock are not shown on any page, so they are left out until
// one uses them.
const shots = import.meta.glob<{ default: ImageMetadata }>([
  "../assets/shots/*.png",
  "!../assets/shots/03-person-documents-*.png",
  "!../assets/shots/05-*.png",
  "!../assets/shots/06-lock-*.png",
]);

async function load(theme: "light" | "dark") {
  const key = `../assets/shots/${shot}-${theme}.png`;
  const loader = shots[key];
  if (!loader) throw new Error(`PhoneFrame: missing src/assets/shots/${shot}-${theme}.png`);
  return (await loader()).default;
}

const fixed = theme ? await load(theme) : undefined;
const light = theme ? undefined : await load("light");
const dark = theme ? undefined : await load("dark");
const sizes = hero ? "(min-width: 52.5em) 340px, 280px" : "(min-width: 52.5em) 300px, 280px";
const loading = hero ? "eager" : "lazy";
const width = 720;
const height = (src: ImageMetadata) => Math.round((width * src.height) / src.width);
---
<figure class:list={["frame", className]} data-crop={crop} data-hero={hero || undefined}>
  <div class="phone">
    <div class="screen">
      {fixed && <Image src={fixed} alt={alt} widths={[360, 720]} format="webp" width={width} height={height(fixed)} sizes={sizes} loading={loading} />}
      {light && <Image src={light} alt={alt} widths={[360, 720]} format="webp" width={width} height={height(light)} sizes={sizes} loading={loading} class="shot-light" />}
      {dark && <Image src={dark} alt={alt} widths={[360, 720]} format="webp" width={width} height={height(dark)} sizes={sizes} loading={loading} class="shot-dark" />}
    </div>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
