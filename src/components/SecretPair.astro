---
// The Masked and Revealed pair as live cards in the moments style.
// Reveal and Hide are static labels, not controls.
---
<figure class="pair">
  <div class="secret">
    <div class="record">
      <span class="badge badge-home" aria-hidden="true">H</span>
      <div>
        <p class="record-name">Maple Street house</p>
        <p class="record-sub">Alarm code</p>
      </div>
    </div>
    <div class="secret-row">
      <p class="record-value"><span aria-hidden="true">••••••••</span><span class="vh">Alarm code, hidden until you tap Reveal</span></p>
      <span class="secret-action" aria-hidden="true">Reveal</span>
    </div>
  </div>
  <figcaption>Masked</figcaption>
</figure>
<figure class="pair">
  <div class="secret">
    <div class="record">
      <span class="badge badge-home" aria-hidden="true">H</span>
      <div>
        <p class="record-name">Maple Street house</p>
        <p class="record-sub">Alarm code</p>
      </div>
    </div>
    <div class="secret-row">
      <p class="record-value">0000</p>
      <span class="secret-action" aria-hidden="true">Hide</span>
    </div>
  </div>
  <figcaption>Revealed</figcaption>
</figure>
