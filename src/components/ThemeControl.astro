---
import Icon from "./Icon.astro";

const choices = [
  { key: "system", icon: "system", label: "System" },
  { key: "light", icon: "sun", label: "Light" },
  { key: "dark", icon: "moon", label: "Dark" },
];
---
<div class="theme-control" role="group" aria-label="Appearance" data-theme-control hidden>
  {choices.map((c) => (
    <button type="button" data-theme-set={c.key} aria-pressed="false"><Icon name={c.icon} size={20} /><span class="tlabel">{c.label}</span></button>
  ))}
</div>
