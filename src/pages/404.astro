---
import Base from "../layouts/Base.astro";
---
<Base title="Page not found | atHand" description="That page could not be found." noindex>
  <div class="wrap">
    <h1>Page not found</h1>
    <p class="lede">We could not find that page. It may have moved, or the link may be wrong.</p>
    <p><a href="/">Go to the atHand home page</a></p>
  </div>
</Base>
<style>
  p > a { display: inline-flex; align-items: center; min-height: var(--touch-min); }
</style>
